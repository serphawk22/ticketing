# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# With no DATABASE_URL the app uses a local SQLite file at data/app.db, which
# needs no credentials. With DATABASE_URL set it uses that Postgres database.
# On Vercel (or any serverless host) DATABASE_URL is required: the filesystem
# is ephemeral there, so a local file would lose every ticket on redeploy.
#
# Use the pooled URL for application traffic and the unpooled one for
# migrations. `neon env pull` writes both:
#   npx neon-cli env pull
DATABASE_URL=""
# Only needed for running migrations (npm run migrate:neon).
DATABASE_URL_UNPOOLED=""

# Optional. Force a driver instead of inferring one, which is handy for
# developing against Neon while keeping a local file around:
#   DB_DRIVER=sqlite     always use data/app.db, ignore DATABASE_URL
#   DB_DRIVER=postgres   always use DATABASE_URL
DB_DRIVER=""

# ---------------------------------------------------------------------------
# Email (invites, assignment / status notifications)
# ---------------------------------------------------------------------------
# Delivery uses SMTP through nodemailer. With no SMTP_SERVER set, mail is not
# sent: it is only written to the email_outbox table and shown on the Employees
# page, and adding an employee warns that the invite did not go out.
SMTP_SERVER="mail.yourdomain.com"
SMTP_PORT="587"
SMTP_SECURE="false"

OUTLOOK_EMAIL="crm@yourdomain.com"
OUTLOOK_PASSWORD="your-app-password-or-mailbox-password"
SENDER_EMAIL="crm@yourdomain.com"

# Public origin of the deployment, used in notification links and in the
# "Sign in to Ticket Manager" button of the invite email.
APP_URL="http://localhost:3000"
