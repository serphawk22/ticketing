# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave TURSO_DATABASE_URL empty to use a local SQLite file at data/app.db.
# On Vercel (or any serverless host) it is required: the filesystem is
# ephemeral there, so a local file would lose every ticket on redeploy.
#
# Create a database with:  npx @libsql/cli db create ticketing
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Email (assignment / status notifications)
# ---------------------------------------------------------------------------
SMTP_SERVER="mail.yourdomain.com"
SMTP_PORT="587"
SMTP_SECURE="false"

OUTLOOK_EMAIL="crm@yourdomain.com"
OUTLOOK_PASSWORD="your-app-password-or-mailbox-password"
SENDER_EMAIL="crm@yourdomain.com"

# Public origin of the deployment, used in notification links.
APP_URL="http://localhost:3000"
